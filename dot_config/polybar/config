[colors]
background = #2d353b
background-alt = #373B41
foreground = #F3F5D9
primary = #b9cef8
pink = #f1739d
blue = #7FBBB3
yellow = #dbbc7f
inactive = #859289
secondary = #8ABEB7
alert = #A54242
disabled = #707880

[bar/left]
monitor=DP-2
width = 14%
offset-x = 1%
offset-y = 1%
height = 28pt
fixed-center = true
background = ${colors.background}
foreground = ${colors.foreground}
line-size = 1pt
font-0 = "RobotoMono Nerd Font:weight=bold:size=9;2"
font-1 = "RobotoMono Nerd Font:size=10;3"
font-2 = "NotoEmoji:scale=11;3"
modules-center=crypto
enable-ipc = true
wm-restack = generic

[bar/middle]
monitor=DP-2
width = 14%
offset-x = 43%
offset-y = 1%
height = 28pt
fixed-center = true
background = ${colors.background}
foreground = ${colors.foreground}
line-size = 1pt
font-0 = "RobotoMono Nerd Font:weight=bold:size=9;2"
font-1 = "RobotoMono Nerd Font:size=10;3"
font-2 = "RobotoMono Nerd Font:size=11;3"
font-3 = "NotoEmoji:scale=11;3"
; modules-center = day space sep space date space sep space time space sep space weather 
modules-center = day space sep space date space sep space weather 
enable-ipc = true
wm-restack = generic

[bar/right]
monitor=DP-2
width = 12%
offset-x = 87%
offset-y = 1%
height = 28pt
fixed-center = true
background = ${colors.background}
foreground = ${colors.foreground}
line-size = 1pt
font-0 = "RobotoMono Nerd Font:weight=bold:size=9;2"
font-1 = "NotoEmoji:scale=11;3"
modules-center = pulseaudio space sep space temp space sep space cpu space sep space memory
enable-ipc = true
wm-restack = generic

[bar/tray]
monitor=DP-2
width = 7%
offset-x = 79%
offset-y = 1%
height = 28pt
fixed-center = true
background = ${colors.background}
foreground = ${colors.foreground}
line-size = 1pt
font-0 = "RobotoMono Nerd Font:size=10;3"
modules-center = tray
tray-position = center
tray-detached = false
tray-maxsize = 16
tray-padding = 4 
enable-ipc = true
wm-restack = generic

